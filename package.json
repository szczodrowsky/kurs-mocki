{
	"name": "kurs-mocki",
	"version": "1.0.0",
	"scripts": {
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"test": "playwright test",
		"format": "biome format --write",
		"check": "biome check --write --unsafe"
	},
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@playwright/test": "1.62.1",
		"@types/node": "26.3.0",
		"husky": "^9.1.7",
		"lint-staged": "17.3.0",
		"typescript": "^7.0.2"
	},

	"engines": {
		"node": "24.14.0",
		"npm": "11.9.0"
	},
	"lint-staged": {
		"*.ts": "biome check --write --diagnostic-level=error --no-errors-on-unmatched",
		"*.{json,md}": "biome format --write --no-errors-on-unmatched"
	}
}
