{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File .codex/hooks/stop.ps1",
						"timeout": 120,
						"statusMessage": "Checking TypeScript and Biome"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -NoProfile -File .codex/hooks/pre-tool-use.ps1",
						"timeout": 10,
						"statusMessage": "Checking force-push policy"
					}
				]
			}
		]
	}
}
